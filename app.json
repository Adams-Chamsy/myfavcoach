{
  "expo": {
    "name": "My Fav Coach",
    "slug": "my-fav-coach",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "myfavcoach",
    "userInterfaceStyle": "light",
    "icon": "./assets/marque/icone-1024.png",
    "ios": {
      "bundleIdentifier": "fr.myfavcoach.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:myfavcoach.fr"]
    },
    "android": {
      "package": "fr.myfavcoach.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/marque/android-foreground-432.png",
        "backgroundColor": "#EFE6D8"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "myfavcoach.fr",
              "pathPrefix": "/y"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12392F",
          "ios": {
            "image": "./assets/marque/splash-android-sombre.png",
            "imageWidth": 260
          },
          "android": {
            "image": "./assets/marque/splash-android-sombre.png",
            "imageWidth": 288
          }
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
