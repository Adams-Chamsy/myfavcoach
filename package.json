{
  "name": "my-fav-coach",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:a11y": "jest src/test/accessibilite.test.tsx --verbose",
    "test:rls": "jest --config jest.rls.config.js --testTimeout=30000 --verbose",
    "test:rls:nettoyage": "node scripts/nettoyer-comptes-banc-rls.mjs",
    "comptes:test": "node scripts/comptes-test-durables.mjs",
    "comptes:test:supprimer": "node scripts/comptes-test-durables.mjs --supprimer",
    "verif:serveur": "node scripts/verifier-serveur-dev.mjs",
    "env:proteger": "node scripts/proteger-env.mjs",
    "verif:bundle": "node scripts/verifier-bundle-production.mjs",
    "verif": "npm run tokens && npm run lint && npm run typecheck && npm test && npm run test:a11y && npm run test:rls && npm run verif:bundle && npm run verif:serveur",
    "reproduire:ci": "bash scripts/reproduire-conditions-ci.sh"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
