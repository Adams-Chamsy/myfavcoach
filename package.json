{
  "name": "my-fav-coach",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tokens": "node scripts/build-tokens.mjs",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:a11y": "jest src/test/accessibilite.test.tsx --verbose",
    "test:rls": "jest --config jest.rls.config.js --testTimeout=30000 --verbose",
    "test:rls:nettoyage": "node scripts/nettoyer-comptes-banc-rls.mjs",
    "anomalies:retraiter": "node scripts/retraiter-anomalies-paiement.mjs",
    "comptes:test": "node scripts/comptes-test-durables.mjs",
    "comptes:test:supprimer": "node scripts/comptes-test-durables.mjs --supprimer",
    "comptes:scenarios": "node scripts/comptes-scenarios.mjs",
    "comptes:scenarios:paiements": "node scripts/comptes-scenarios.mjs --paiements",
    "comptes:scenarios:supprimer": "node scripts/comptes-scenarios.mjs --supprimer",
    "verif:fonctions": "node scripts/verifier-fonctions.mjs",
    "verif:serveur": "node scripts/verifier-serveur-dev.mjs",
    "env:proteger": "node scripts/proteger-env.mjs",
    "verif:bundle": "node scripts/verifier-bundle-production.mjs",
    "verif": "npm run tokens && npm run lint && npm run typecheck && npm test && npm run test:a11y && npm run test:rls && npm run verif:fonctions && npm run verif:bundle && npm run verif:serveur",
    "reproduire:ci": "bash scripts/reproduire-conditions-ci.sh"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.6",
    "supabase": "2.122.0",
    "typescript": "~6.0.3"
  }
